# ---- LLM provider -----------------------------------------------------------
# caii              = Cloudera AI Inference (default): open-weight model endpoint, OpenAI-compatible API
# openai_compatible = any other OpenAI-compatible server hosting an open-weight model
#                     (vLLM, Ollama, NIM container) for laptop use
LLM_PROVIDER=caii
LLM_BASE_URL=https://<caii-domain>/namespaces/serving-default/endpoints/<endpoint>/v1
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# Auth precedence: LLM_API_KEY > CDP_TOKEN > /tmp/jwt (injected by Cloudera AI, validated)
#   > CML_JWT_FALLBACK_PATH (.secrets/jwt.json written by deploy/save_session_token.py)
#CML_JWT_FALLBACK_PATH=/home/cdsw/.secrets/jwt.json
#CDP_TOKEN=
#LLM_API_KEY=
# Laptop alternative (open-weight model on a local server):
#LLM_PROVIDER=openai_compatible
#LLM_BASE_URL=http://localhost:8000/v1
#LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#LLM_API_KEY=

# ---- OpenSearch -------------------------------------------------------------
# embedded = started inside the Cloudera AI application pod by deploy/app.py
# external = docker-compose (laptop) or any OpenSearch 2.x cluster with the k-NN plugin
OPENSEARCH_MODE=embedded
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=product-catalog
#OPENSEARCH_USER=
#OPENSEARCH_PASSWORD=
#OPENSEARCH_CA_CERT=/path/to/ca.pem
#OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_VERSION=2.11.0
OPENSEARCH_DATA_DIR=/tmp/opensearch-data
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ---- Tabular data -----------------------------------------------------------
# duckdb = data/store.db (laptop)   impala = Iceberg tables via Cloudera Data Warehouse
DB_BACKEND=impala
IMPALA_HOST=coordinator-<virtual-warehouse>.dw-<env>.cloudera.site
IMPALA_PORT=443
IMPALA_HTTP_PATH=cliservice
IMPALA_USER=<workload-user>
IMPALA_PASSWORD=<workload-password>
IMPALA_DATABASE=new_item_eval
#DB_BACKEND=duckdb
#DUCKDB_PATH=data/store.db

# ---- Misc -------------------------------------------------------------------
CLIP_CACHE_DIR=/home/cdsw/.cache/clip
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
CORS_ORIGINS=http://localhost:5173
